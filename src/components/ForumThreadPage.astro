---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import {
	absoluteForumUrl,
	getForumBasePath,
	getForumThreadHreflangAlternates,
} from '../data/forum/helpers';
import type { ResolvedForumThread } from '../data/forum/types';
import { siteConfig } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';

interface Props {
	thread: ResolvedForumThread;
}

const { thread } = Astro.props;
const homeHref = getLocalizedPath('home', 'en');
const forumHref = getForumBasePath();
const threadUrl = absoluteForumUrl(thread.slug);
const hreflangAlternates = getForumThreadHreflangAlternates(thread);

function pageTitle(headline: string): string {
	const suffix = ' | THE FINALS Forum';
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	if (headline.length <= 60) return headline;
	const trimmed = headline.slice(0, 57);
	const cut = trimmed.lastIndexOf(' ');
	return `${(cut > 40 ? trimmed.slice(0, cut) : trimmed).replace(/[|:–—-]+$/, '').trim()}…`;
}

const articleSchema = {
	'@type': 'Article',
	'@id': `${threadUrl}#article`,
	url: threadUrl,
	headline: thread.title,
	description: thread.metaDescription,
	inLanguage: 'en',
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${threadUrl}#webpage`,
	},
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: thread.keywords.join(', '),
	articleSection: thread.category,
};
---

<Layout
	title={pageTitle(thread.title)}
	description={thread.metaDescription}
	canonicalPath={thread.canonicalPath}
	hreflangAlternates={hreflangAlternates}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={thread.title}
	type="article"
	locale="en"
	breadcrumbs={[
		{ label: 'Home', href: homeHref },
		{ label: 'Forum', href: forumHref },
		{ label: thread.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar pageId="home" />
	<main class="forum-thread">
		<div class="shell">
			<div class="shell-content forum-thread__inner">
				<article>
					<header class="forum-thread__header">
						<p class="forum-thread__cat">{thread.category}</p>
						<h1>{thread.h1}</h1>
						<p class="forum-thread__intro">{thread.intro}</p>
					</header>

					<section class="forum-thread__section">
						<h2>What you get when you buy</h2>
						{thread.whatYouGet.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</section>

					<section class="forum-thread__section">
						<h2>Features list</h2>
						<ul class="forum-thread__features">
							{
								thread.featuresList.map((item) => {
									const [label, ...rest] = item.split(' — ');
									const detail = rest.join(' — ');
									return (
										<li>
											<strong>{label}</strong>
											{detail ? ` — ${detail}` : ''}
										</li>
									);
								})
							}
						</ul>
					</section>

					<section class="forum-thread__section">
						<h2>Next step</h2>
						{thread.nextStep.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</section>

					<aside class="forum-thread__cta">
						<h2>{thread.cta.title}</h2>
						<p set:html={thread.cta.body} />
						<div class="forum-thread__cta-actions">
							<a class="forum-thread__btn forum-thread__btn--ghost" href={thread.cta.primaryHref}>
								{thread.cta.primaryLabel}
							</a>
							<a class="forum-thread__btn forum-thread__btn--ghost" href={thread.cta.secondaryHref}>
								{thread.cta.secondaryLabel}
							</a>
							<a
								class="forum-thread__btn forum-thread__btn--buy"
								href={thread.cta.checkoutHref}
								rel="noopener noreferrer"
							>
								{thread.cta.checkoutLabel}
							</a>
						</div>
					</aside>
				</article>

				<p class="forum-thread__back">
					<a href={forumHref}>← All forum threads</a>
				</p>
			</div>
		</div>
	</main>
	<SiteFooter />
</Layout>

<style>
	.forum-thread {
		padding: 2.5rem 0 4rem;
	}

	.forum-thread__cat {
		margin: 0 0 0.5rem;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.forum-thread__header h1 {
		margin: 0 0 0.85rem;
		font-size: clamp(1.7rem, 3.5vw, 2.35rem);
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.forum-thread__intro {
		margin: 0 0 2rem;
		max-width: 44rem;
		color: var(--ink-body);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.forum-thread__section {
		margin-bottom: 2rem;
	}

	.forum-thread__section h2 {
		margin: 0 0 0.85rem;
		font-size: 1.35rem;
		line-height: 1.2;
	}

	.forum-thread__section p {
		margin: 0 0 0.85rem;
		max-width: 44rem;
		color: var(--ink-body);
		line-height: 1.7;
	}

	.forum-thread__features {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 44rem;
	}

	.forum-thread__features li {
		margin-bottom: 0.75rem;
		color: var(--ink-body);
		line-height: 1.65;
	}

	.forum-thread__features strong {
		color: rgba(255, 255, 255, 0.92);
		font-weight: 600;
	}

	.forum-thread__cta {
		margin-top: 2.5rem;
		padding: 1.35rem 1.4rem 1.45rem;
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		border-radius: var(--radius-md, 0.75rem);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--magenta) 8%, var(--bg-panel)), var(--bg-panel));
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--magenta) 10%, transparent),
			0 16px 40px rgba(0, 0, 0, 0.28);
	}

	.forum-thread__cta h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	.forum-thread__cta p {
		margin: 0 0 1.15rem;
		max-width: 44rem;
		color: var(--ink-body);
		line-height: 1.65;
	}

	.forum-thread__cta p :global(a) {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.forum-thread__cta p :global(a:hover) {
		color: var(--ink);
	}

	.forum-thread__cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.forum-thread__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0 1rem;
		border-radius: 999px;
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.forum-thread__btn--ghost {
		border: 1px solid color-mix(in srgb, var(--line) 90%, #fff 10%);
		background: transparent;
		color: var(--ink);
	}

	.forum-thread__btn--ghost:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: color-mix(in srgb, var(--magenta) 8%, transparent);
	}

	.forum-thread__btn--buy {
		border: 1px solid color-mix(in srgb, var(--magenta) 45%, transparent);
		background: linear-gradient(180deg, var(--magenta-soft), var(--magenta));
		color: #09090b;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--magenta) 28%, transparent);
	}

	.forum-thread__btn--buy:hover {
		transform: translateY(-1px);
	}

	.forum-thread__back {
		margin: 2rem 0 0;
	}

	.forum-thread__back a {
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.forum-thread__back a:hover {
		color: var(--magenta-soft);
	}

	@media (max-width: 640px) {
		.forum-thread__cta-actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
