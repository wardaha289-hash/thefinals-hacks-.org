---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { getAllThreads, getForumBasePath, getForumIndexHreflangAlternates, absoluteForumUrl } from '../data/forum/helpers';
import { siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';

const threads = getAllThreads();
const canonicalPath = getForumBasePath();
const canonicalURL = absoluteForumUrl();
const hreflangAlternates = getForumIndexHreflangAlternates();
const homeHref = getLocalizedPath('home', 'en');

const pageTitle = seoPageTitle(brandSeo.forumTitle);
const pageDescription = seoDescription(brandSeo.forumDescription);

const categoryIcons: Record<string, string> = {
	Setup: 'M12 4.5v4.2M8.2 8.7h7.6M6.5 19.5h11a1.5 1.5 0 001.5-1.5V9.2L12 5.5 5 9.2v8.8a1.5 1.5 0 001.5 1.5z',
	Features: 'M12 5a7 7 0 100 14 7 7 0 000-14zm0 2.2a4.8 4.8 0 110 9.6 4.8 4.8 0 010-9.6zM12 10.2v2.4l1.8 1.1',
	Instructions: 'M7.5 7.2h9M7.5 12h9M7.5 16.8H14M5 4.8h14a1.2 1.2 0 011.2 1.2v12a1.2 1.2 0 01-1.2 1.2H5A1.2 1.2 0 013.8 18V6A1.2 1.2 0 015 4.8z',
};

const listSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: 'Setup, Features & Configuration',
	description: pageDescription,
	url: canonicalURL,
	inLanguage: 'en',
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: threads.map((thread, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteForumUrl(thread.slug),
			name: thread.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale="en"
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt="THE FINALS Hacks Forum"
	breadcrumbs={[{ label: 'Home', href: homeHref }, { label: 'Forum' }]}
	extraGraph={[listSchema]}
>
	<Navbar pageId="home" />
	<main class="forum">
		<div class="shell forum__inner">
			<header class="forum__hero">
				<p class="forum__eyebrow">Forum</p>
				<h1>Setup, Features &amp; Configuration</h1>
				<p class="forum__intro">
					Short threads for THE FINALS Hacks setup, ESP, soft aim, radar, and performance tuning on Windows PC.
				</p>
			</header>

			<section class="forum__grid" aria-label="Forum threads">
				{
					threads.map((thread) => (
						<article class="forum__card">
							<a href={thread.canonicalPath}>
								<span class="forum__cat">
									<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path
											d={categoryIcons[thread.category]}
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									{thread.category}
								</span>
								<h2>{thread.title}</h2>
								<p>{thread.intro}</p>
								<span class="forum__more">Read thread →</span>
							</a>
						</article>
					))
				}
			</section>
		</div>
	</main>
	<SiteFooter />
</Layout>

<style>
	.forum {
		padding: 2.5rem 0 4rem;
	}

	.forum__hero {
		margin-bottom: 2rem;
	}

	.forum__eyebrow {
		margin: 0 0 0.5rem;
		color: var(--magenta-soft);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.75rem;
	}

	.forum__hero h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.forum__intro {
		max-width: 42rem;
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.forum__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.forum__card a {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 13.5rem;
		padding: 1.15rem 1.2rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg-panel) 92%, transparent);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.forum__card a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--magenta) 12%, transparent),
			0 12px 32px rgba(0, 0, 0, 0.28);
		transform: translateY(-2px);
	}

	.forum__cat {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0.85rem;
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.forum__cat svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.forum__card h2 {
		margin: 0 0 0.65rem;
		font-size: 1.08rem;
		line-height: 1.28;
		letter-spacing: -0.015em;
	}

	.forum__card p {
		margin: 0;
		flex: 1;
		color: rgba(255, 255, 255, 0.62);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.forum__more {
		display: inline-block;
		margin-top: 1rem;
		color: var(--magenta-soft);
		font-size: 0.82rem;
		font-weight: 600;
	}

	@media (max-width: 980px) {
		.forum__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.forum__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
