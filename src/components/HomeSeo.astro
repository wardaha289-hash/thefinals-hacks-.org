---
import HomeSeoApp from './react/HomeSeo';
import { homeFaqs } from '../data/site';
import { getFaqPath } from '../data/faq';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const faqs = homeFaqs.map((item) => ({
	slug: item.slug,
	question: item.question,
	answer: item.answer,
	href: getFaqPath(item.slug),
}));

const previewSrc = '/images/finals-hacks-match-preview.webp';
const previewAlt = 'THE FINALS hacks in match — ESP boxes, aimbot FOV, and player overlays';
---

<HomeSeoApp client:visible locale={locale} faqs={faqs} previewSrc={previewSrc} previewAlt={previewAlt} />

<style is:global>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-seo__intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
		grid-template-areas: 'copy preview';
		gap: clamp(1.5rem, 3vw, 2.5rem);
		align-items: center;
		margin-bottom: clamp(1.5rem, 2.5vw, 2rem);
	}

	.home-seo__copy {
		grid-area: copy;
		min-width: 0;
	}

	.home-seo__about h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__about p {
		margin: 0 0 0.85rem;
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--ink-body);
	}

	.home-seo__about p:last-child {
		margin-bottom: 0;
	}

	.home-seo__about a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-seo__about a:hover {
		color: var(--ink);
	}

	.home-seo__preview {
		grid-area: preview;
		position: relative;
		margin: 0;
		border-radius: 1.1rem;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		box-shadow:
			0 1.5rem 3rem color-mix(in srgb, var(--bg) 35%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--ink) 6%, transparent);
	}

	.home-seo__preview img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.home-seo__preview-badge {
		position: absolute;
		left: 0.85rem;
		bottom: 0.85rem;
		margin: 0;
		padding: 0.38rem 0.72rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
		background: color-mix(in srgb, var(--bg-panel) 82%, transparent);
		border: 1px solid var(--line-soft);
		backdrop-filter: blur(8px);
	}

	.home-seo__cats-wrap {
		margin-top: clamp(1.75rem, 3vw, 2.25rem);
	}

	.home-seo__buy h2,
	.home-seo__faq-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__buy {
		margin-top: 2rem;
		padding: clamp(1.25rem, 2.5vw, 1.65rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.home-seo__buy p {
		margin: 0.65rem 0 0.85rem;
		max-width: 36rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-body);
	}

	.home-seo__buy-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-seo__buy-links a {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__buy-links a:hover {
		color: var(--ink);
	}

	.home-seo__cats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
		align-items: stretch;
		margin-top: 0.25rem;
	}

	.home-seo__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.home-seo__cat:hover {
		transform: translateY(-1px);
	}

	.home-seo__cat--features:hover {
		border-color: color-mix(in srgb, #a855f7 35%, var(--line));
	}

	.home-seo__cat--status:hover {
		border-color: color-mix(in srgb, #34d399 35%, var(--line));
	}

	.home-seo__cat--store:hover {
		border-color: color-mix(in srgb, #60a5fa 35%, var(--line));
	}

	.home-seo__cat--help:hover {
		border-color: color-mix(in srgb, #fbbf24 35%, var(--line));
	}

	.home-seo__cat-head {
		padding: 0.95rem 1rem 0.8rem;
		border-bottom: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
	}

	.home-seo__cat-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		text-transform: lowercase;
	}

	.home-seo__cat--features .home-seo__cat-head h3 {
		color: #c084fc;
	}

	.home-seo__cat--status .home-seo__cat-head h3 {
		color: #34d399;
	}

	.home-seo__cat--store .home-seo__cat-head h3 {
		color: #60a5fa;
	}

	.home-seo__cat--help .home-seo__cat-head h3 {
		color: #fbbf24;
	}

	.home-seo__cat-head p {
		margin: 0.3rem 0 0;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.home-seo__cat ul {
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		display: grid;
		flex: 1;
	}

	.home-seo__cat a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 1rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.home-seo__cat-arrow {
		width: 0.35rem;
		height: 0.35rem;
		flex-shrink: 0;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(-45deg);
		opacity: 0;
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.home-seo__cat--features a:hover {
		background: color-mix(in srgb, #a855f7 10%, transparent);
		color: #d8b4fe;
	}

	.home-seo__cat--status a:hover {
		background: color-mix(in srgb, #34d399 10%, transparent);
		color: #6ee7b7;
	}

	.home-seo__cat--store a:hover {
		background: color-mix(in srgb, #60a5fa 10%, transparent);
		color: #93c5fd;
	}

	.home-seo__cat--help a:hover {
		background: color-mix(in srgb, #fbbf24 10%, transparent);
		color: #fde68a;
	}

	.home-seo__cat a:hover .home-seo__cat-arrow {
		opacity: 0.9;
		transform: rotate(-45deg) translate(1px, 1px);
	}

	.home-seo__faq {
		margin-top: 2.25rem;
		padding: clamp(1.35rem, 3vw, 1.85rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 70% 80% at 100% 0%, color-mix(in srgb, var(--magenta) 10%, transparent), transparent 50%),
			var(--bg-panel);
	}

	.home-seo__faq-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.15rem;
		padding-bottom: 1.05rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__faq-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__faq-lede {
		margin: 0.45rem 0 0;
		max-width: 36rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-body);
	}

	.home-seo__faq-link {
		flex-shrink: 0;
		margin-top: 0.35rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
		white-space: nowrap;
	}

	.home-seo__faq-link:hover {
		color: var(--ink);
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.45rem;
	}

	.home-seo__item {
		margin: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg) 55%, var(--bg-elevated));
		overflow: hidden;
	}

	.home-seo__item[open],
	.home-seo__item:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		padding: 0.95rem 1.05rem;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink);
	}

	.home-seo__item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__item[open] summary {
		border-bottom: 1px solid var(--line-soft);
		color: var(--magenta-soft);
	}

	.home-seo__chev {
		position: relative;
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
	}

	.home-seo__chev::before,
	.home-seo__chev::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background: var(--magenta-soft);
		border-radius: 999px;
	}

	.home-seo__chev::before {
		width: 0.45rem;
		height: 1.5px;
		transform: translate(-50%, -50%);
	}

	.home-seo__chev::after {
		width: 1.5px;
		height: 0.45rem;
		transform: translate(-50%, -50%);
	}

	.home-seo__item[open] .home-seo__chev::after {
		opacity: 0;
	}

	.home-seo__item-body {
		display: grid;
		gap: 0.65rem;
		padding: 0.85rem 1.05rem 1.05rem;
	}

	.home-seo__item-body p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-body);
	}

	.home-seo__item-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__item-link:hover {
		color: var(--ink);
	}

	@media (max-width: 768px) {
		.home-seo__intro {
			grid-template-columns: 1fr;
			grid-template-areas:
				'copy'
				'preview';
		}

		.home-seo__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.home-seo__faq-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.home-seo__faq-link {
			margin-top: 0;
			min-height: var(--touch-min, 2.75rem);
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.home-seo__cats {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-seo__faq {
			padding: 1.1rem 1rem 1.15rem;
			margin-top: 1.75rem;
		}

		.home-seo__item summary {
			min-height: var(--touch-min, 2.75rem);
			padding: 0.85rem 1rem;
		}
	}
</style>
